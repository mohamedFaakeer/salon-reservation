# ------------------------------------------------------------------
# Salon Reservation MVP — root environment (dev defaults)
# Copy to `.env` (gitignored) and adjust. Apps may also provide
# app-local `.env` files (apps/web, apps/admin) for Next.js vars.
# Local CORS allow-list: http://localhost:3001,http://localhost:3002
# ------------------------------------------------------------------

# --- API (apps/api) ---
NODE_ENV=development
PORT=3000

# Local Postgres 17 (docker compose) — prod uses the Neon URL w/ sslmode=require
DATABASE_URL=postgresql://salon:salon@localhost:5432/salon

# Auth (self-hosted, argon2 + jose)
# DEV VALUE ONLY. Every value in this file is public in the repository, so the
# API refuses to boot with NODE_ENV=production while any of them is still set.
# Generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-min-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
AUTH_COOKIE_NAME=salon_session

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Payments — MVP default: manual (record-only). PayHere = stub behind flag.
PAYMENTS_PROVIDER=manual
PAYMENTS_PAYHERE_ENABLED=false

# Notifications — console always works offline; email optional
NOTIFICATIONS_CHANNELS=console,email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Salon logo uploads — unset means POST /tenant/me/logo returns 503, everything else still works
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Security
RATE_LIMIT_ENABLED=true
LOG_LEVEL=debug

# Super-admin — read by the identity migration when it seeds the platform
# administrator. In production SUPER_ADMIN_PASSWORD is required: the migration
# will not fall back to the development default.
SUPER_ADMIN_EMAIL=super.admin@salon.local
SUPER_ADMIN_PASSWORD=change-me-strong-password

# Demo salon (elegance + owner/manager/receptionist/staff logins).
# Seeded automatically outside production. In production these accounts are
# skipped entirely unless DEMO_OWNER_PASSWORD is set on purpose — they are
# known addresses on a public URL.
DEMO_OWNER_PASSWORD=

# --- Customer app (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# SSR-only (non-public) fetches from the API
API_SERVER_URL=http://localhost:3000/api/v1

# --- Admin app (apps/admin) ---
# NEXT_PUBLIC_API_URL + AUTH_COOKIE_NAME shared above by convention