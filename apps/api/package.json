{
  "name": "@salon/api",
  "version": "0.1.0",
  "private": true,
  "description": "Salon Reservation API — NestJS 11 + TypeORM 1.x + PostgreSQL",
  "scripts": {
    "predev": "npm run build -w @salon/shared",
    "prebuild": "npm run build -w @salon/shared",
    "dev": "cross-env NODE_OPTIONS=--preserve-symlinks nest start --watch",
    "start": "cross-env NODE_OPTIONS=--preserve-symlinks node dist/main.js",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && cross-env NODE_OPTIONS=--preserve-symlinks node --test \"dist-e2e/test/**/*.e2e-spec.js\"",
    "build:e2e": "tsc -p tsconfig.e2e.json",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/infrastructure/database/data-source.ts",
    "db:migrate:prod": "cross-env NODE_ENV=production typeorm-ts-node-commonjs migration:run -d src/infrastructure/database/data-source.ts",
    "db:rollback": "typeorm-ts-node-commonjs migration:revert -d src/infrastructure/database/data-source.ts",
    "db:seed:demo": "ts-node src/infrastructure/database/seed-demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@salon/shared": "*",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.8",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}